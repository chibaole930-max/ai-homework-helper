{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-telegram-notifier",
    "@azumag/opencode-rate-limit-fallback"
  ],
  "default_agent": "build",
  "model": "opencode/big-pickle",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode/big-pickle"
    },
    "general": {
      "mode": "subagent",
      "model": "opencode/big-pickle"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/big-pickle"
    }
  },
  "compaction": {
    "auto": false
  }
}